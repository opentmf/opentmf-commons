<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{mm:ss.SSS} %-8level [%thread] %class{1} -- %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.pia" level="TRACE"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
